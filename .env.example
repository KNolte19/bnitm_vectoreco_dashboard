# VectorEco Dashboard – environment variables example
# Copy this file to .env and fill in your values.

# ── SMTP settings for email alert notifications ──────────────────────────────
# If SMTP_HOST is not set, the alert scheduler will not start and no emails
# will be sent. All other settings are optional when SMTP_HOST is absent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@example.com

# ── Dropbox sync – Felix's data (JSON files) ─────────────────────────────────
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_FOLDER=/ab_uploads/

# ── Dropbox sync – Leif's data (JSONL files, same API credentials) ───────────
LEIF_DROPBOX_FOLDER=/leif_uploads/

# ── Database paths ────────────────────────────────────────────────────────────
# Felix's measurements database (default: data/measurements.db)
# DB_PATH=data/measurements.db

# Leif's measurements database (default: data/leif_measurements.db)
# LEIF_DB_PATH=data/leif_measurements.db

# ── Inbox / archive directories ───────────────────────────────────────────────
# Felix's file inbox (JSON)
# INBOX_DIR=data/inbox
# ARCHIVE_DIR=data/archive

# Leif's file inbox (JSONL)
# LEIF_INBOX_DIR=data/leif_inbox
# LEIF_ARCHIVE_DIR=data/leif_archive
